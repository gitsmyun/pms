# Frontend Environment Variables Template
# 이 파일은 팀 공유용 템플릿입니다.

# Keycloak 서버 URL (빌드 타임 주입)
# 로컬 개발: http://localhost:8280 (Keycloak HTTP 포트)
# 개발서버 (Argo CD): https://10.127.6.102/keycloak (Ingress 경로)
# 시험서버 (AWS): https://pms-staging.duckdns.org/keycloak
VITE_KEYCLOAK_URL=http://localhost:8280

# API Base URL (local에서는 Vite Proxy 사용, 운영에서는 Ingress/Gateway 사용)
# VITE_API_BASE_URL=

# OIDC Configuration (Phase 2: 프론트 OIDC PKCE 로그인)
# VITE_OIDC_ISSUER_URI=https://dev-sso.example.com/realms/pms
# VITE_OIDC_CLIENT_ID=pms-frontend
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
# VITE_OIDC_SCOPE=openid profile email

